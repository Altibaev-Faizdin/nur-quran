# Noor Al-Quran — Environment Configuration Template
# Copy this file to .env and fill in the values for production deployment.

# ==============================================================================
# DJANGO CORE SETTINGS
# ==============================================================================
# Set DEBUG to False in production!
DEBUG=False

# SECRET_KEY must be a cryptographically secure string (at least 50 random characters)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=replace-this-with-a-very-long-and-cryptographically-secure-random-secret-key-at-least-50-chars

# Comma-separated list of allowed hostnames
ALLOWED_HOSTS=nur-quran.onrender.com,nuur-quran.onrender.com,localhost,127.0.0.1

# ==============================================================================
# DATABASE (PostgreSQL in production, SQLite fallback in development)
# ==============================================================================
# PostgreSQL connection string: postgres://user:password@host:port/dbname
DATABASE_URL=postgres://user:password@localhost:5432/nur_quran

# ==============================================================================
# SECURITY & CORS
# ==============================================================================
# Comma-separated list of origins allowed to make cross-origin requests
CORS_ALLOWED_ORIGINS=https://nur-quran.netlify.app,https://nuur-quran.netlify.app,https://nur-quran.onrender.com

# Comma-separated list of origins trusted for CSRF protection
CSRF_TRUSTED_ORIGINS=https://nur-quran.netlify.app,https://nuur-quran.netlify.app,https://nur-quran.onrender.com

# Reverse proxy setting: number of upstream proxies (e.g. 1 on Render/Heroku)
NUM_PROXIES=1

# ==============================================================================
# CACHING (Redis recommended for production, FileBasedCache default fallback)
# ==============================================================================
# REDIS_URL=redis://localhost:6379/1

# ==============================================================================
# EMAIL / SMTP (Required for password reset and notifications)
# ==============================================================================
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=noreply@noor-alquran.com
EMAIL_HOST_PASSWORD=your-secure-app-password
DEFAULT_FROM_EMAIL=Noor Al-Quran <noreply@noor-alquran.com>

