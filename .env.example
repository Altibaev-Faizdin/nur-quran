# Noor Al-Quran — Environment Configuration Template
# Copy to .env (never commit .env to Git)

# Set False in production
DEBUG=False

# Cryptographically random key (>= 50 chars required when DEBUG=False)
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# Comma-separated hostnames serving the Django API/app
ALLOWED_HOSTS=localhost,127.0.0.1,nur-quran.onrender.com

# PostgreSQL in production (omit for local SQLite development)
# DATABASE_URL=postgres://user:password@host:5432/nur_quran?sslmode=require

# Comma-separated frontend origins allowed for CORS & CSRF (with credentials)
CORS_ALLOWED_ORIGINS=https://noor-al-quran.netlify.app,http://localhost:8000,http://127.0.0.1:8000

# Reverse proxy hop count (1 behind Render / Nginx)
NUM_PROXIES=1

# HttpOnly refresh cookie flags (auto True when DEBUG=False; set False only for local HTTP E2E testing)
# COOKIE_SECURE=True
# COOKIE_SAMESITE=Lax

# Optional external CDN base URL hosting custom reciter MP3s (served via /api/config/)
# AUDIO_CDN_BASE=

# Optional Redis URL for shared caching
# REDIS_URL=redis://localhost:6379/1

# Enforce HTTPS redirect in production (True by default when DEBUG=False)
# SECURE_SSL_REDIRECT=True
