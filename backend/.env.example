# Noor Al-Quran — Backend Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# ─── Required ────────────────────────────────────────────────────────────────
# Generate a new key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-long-random-50-plus-character-string

# Set to False in production
DEBUG=True

# Comma-separated. In production: your-domain.com,api.your-domain.com
ALLOWED_HOSTS=localhost,127.0.0.1

# SQLite for local dev. In production use PostgreSQL:
# postgres://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=sqlite:///db.sqlite3

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated. In production: https://your-frontend.netlify.app
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─── Optional ────────────────────────────────────────────────────────────────
# Redis for caching external API calls (prayer times, etc.)
# REDIS_URL=redis://127.0.0.1:6379/1

# Set to False when behind a reverse proxy (Render/Railway/Netlify)
# The proxy handles TLS termination. Setting True here would cause redirect loops.
# SECURE_SSL_REDIRECT=False
