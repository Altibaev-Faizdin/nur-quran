{
  "name": "nur-quran",
  "version": "2.1.0",
  "description": "Noor Al-Quran — Islamic digital platform (Python Django REST Framework + Vanilla PWA frontend)",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run lint && npm run test",
    "lint": "eslint scripts tests frontend/*.js frontend/js/pages/*.js",
    "format": "prettier --write scripts tests frontend/css/pages.css frontend/js/pages/*.js",
    "format:check": "prettier --check scripts tests frontend/css/pages.css frontend/js/pages/*.js",
    "test:frontend": "node scripts/test-runner.mjs && node scripts/verify-security.mjs",
    "test:math": "node --test tests/math.test.js",
    "test:e2e": "npx playwright test",
    "test:audio": "node scripts/verify-audio.mjs",
    "test": "npm run test:math && npm run test:frontend",
    "version-assets": "node scripts/version-assets.mjs",
    "serve": "python3 backend/manage.py runserver 0.0.0.0:8000"
  },
  "keywords": [
    "quran",
    "islamic",
    "prayer-times",
    "hadith",
    "pwa",
    "audio-streaming"
  ],
  "author": "Noor Al-Quran Team",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1"
  }
}
